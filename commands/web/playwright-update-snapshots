#!/bin/bash

#ddev-generated
## Description: Regenerate Playwright visual regression baselines (screenshots)
## Usage: playwright-update-snapshots [--env=pro|local] [test arguments]
## Example: "ddev playwright-update-snapshots --env=pro" or "ddev playwright-update-snapshots --env=pro cisac-visual.spec.ts" or "ddev playwright-update-snapshots --env=pro --project=chrome-desktop"

TEST_DIR="${PLAYWRIGHT_TEST_DIR:-tests/playwright}"
cd "/var/www/html/${TEST_DIR}"

# Pull the environment out of the args (TEST_ENV selects the spec folder + the
# baseURL in playwright.config.ts). Defaults to pro. Accepts --env=local and
# --env local.
env="pro"
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    --env=*) env="${1#--env=}" ;;
    --env)   env="$2"; shift ;;
    *)       rest+=("$1") ;;
  esac
  shift
done
export TEST_ENV="$env"

# Strip the repo-root prefix from path arguments so both styles work:
#   ddev playwright-update-snapshots --env=pro pro/cisac-visual.spec.ts
#   ddev playwright-update-snapshots --env=pro tests/playwright/pro/cisac-visual.spec.ts
args=()
for arg in "${rest[@]}"; do
  args+=("${arg#"${TEST_DIR}/"}")
done

# The "=" form is required: --update-snapshots takes an optional mode value
# and would otherwise swallow the first positional argument (the test file).
npx playwright test --update-snapshots=changed "${args[@]}"
status=$?

echo ""
echo "Baselines written under ${TEST_DIR}/snapshots/ — review and commit the changes."

exit "${status}"
