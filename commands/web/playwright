#!/bin/bash

#ddev-generated
## Description: Run Playwright tests inside the web container
## Usage: playwright [--env=pro|local] [test arguments]
## Example: "ddev playwright --env=local" or "ddev playwright --env=pro --project=chrome-desktop" or "ddev playwright --env=local admin-create-page.spec.ts"

TEST_DIR="${PLAYWRIGHT_TEST_DIR:-tests/playwright}"
cd "/var/www/html/${TEST_DIR}"

# Pull the environment out of the args (TEST_ENV selects the spec folder + the
# baseURL in playwright.config.ts). Defaults to pro. Accepts --env=local and
# --env local.
env="pro"
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    --env=*) env="${1#--env=}" ;;
    --env)   env="$2"; shift ;;
    *)       rest+=("$1") ;;
  esac
  shift
done
export TEST_ENV="$env"

# Strip the repo-root prefix from path arguments so both styles work:
#   ddev playwright --env=pro pro/contact.spec.ts                 (relative)
#   ddev playwright --env=pro tests/playwright/pro/contact.spec.ts (repo-root)
args=()
for arg in "${rest[@]}"; do
  args+=("${arg#"${TEST_DIR}/"}")
done

# Keep the test exit code (Jenkins relies on it) but always show the report hint.
status=0
npx playwright test "${args[@]}" || status=$?

echo ""
echo "View the HTML report with:  ddev playwright-report"

exit "${status}"
