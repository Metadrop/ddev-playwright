#!/bin/bash

#ddev-generated
## Description: Print a Markdown accessibility (a11y) summary from the Playwright JSON report
## Usage: playwright-a11y-summary [--mode=summary|annotations] [--report-path=PATH]
## Example: "ddev playwright-a11y-summary" or "ddev playwright-a11y-summary --mode=annotations"

set -e

TEST_DIR="${PLAYWRIGHT_TEST_DIR:-tests/playwright}"
cd "/var/www/html/${TEST_DIR}"

# Consume the JSON reporter output written by `ddev playwright` (the ['json']
# reporter in playwright.config.ts). Override with --report-path=...; any other
# arg (e.g. --mode=annotations) is forwarded to the summary CLI untouched.
report_path="test-results/results.json"
args=()
for arg in "$@"; do
  case "$arg" in
    --report-path=*) report_path="${arg#--report-path=}" ;;
    *)               args+=("$arg") ;;
  esac
done

if [ ! -f "$report_path" ]; then
  echo "No Playwright JSON report at ${TEST_DIR}/${report_path}."
  echo "Run the accessibility tests first:  ddev playwright --grep @a11y"
  echo "(Needs the ['json'] reporter in playwright.config.ts.)"
  exit 1
fi

# Shipped by @lullabot/playwright-drupal; resolved from the test dir's bin.
npx playwright-drupal-a11y-summary --report-path="$report_path" "${args[@]}"
